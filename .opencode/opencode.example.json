{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": "allow",
    "write": "allow"
  },
  "mcp": {
    "jira": {
      "type": "local",
      "command": ["node", "node_modules/jira-server/build/index.js"],
      "enabled": true,
      "env": {
        "JIRA_EMAIL": "your-email@example.com",
        "JIRA_API_TOKEN": "your-jira-api-token",
        "JIRA_DOMAIN": "your-domain.atlassian.net"
      }
    }
  }
}
